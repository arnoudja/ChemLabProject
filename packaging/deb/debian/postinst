#!/bin/sh
set -e

if ! getent group chemlab >/dev/null 2>&1; then
    addgroup --system chemlab
fi

if ! getent passwd chemlab >/dev/null 2>&1; then
    adduser --system --ingroup chemlab --home /var/lib/chemlab \
        --no-create-home --disabled-login --gecos "ChemLab server" chemlab
fi

install -d -o chemlab -g chemlab -m 0750 /var/lib/chemlab

if [ -f /etc/chemlab/chemlab.env ]; then
    chown root:chemlab /etc/chemlab/chemlab.env
    chmod 0640 /etc/chemlab/chemlab.env
fi

if [ -d /run/systemd/system ]; then
    systemctl daemon-reload
    systemctl enable --now chemlab.service
fi

exit 0
