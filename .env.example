# Host:port for the API. Use 0.0.0.0:3847 to accept LAN connections.
CHEMLAB_BIND=127.0.0.1:3847
# Vite dev server bind host (apps/web). Use 0.0.0.0 for LAN access.
CHEMLAB_VITE_HOST=127.0.0.1
# CHEMLAB_VITE_PORT=5179
CHEMLAB_DATABASE_URL=sqlite://chemlab.db
# Dev: proxy non-API routes to Vite (optional; Vite can also proxy /api to Axum)
# CHEMLAB_VITE_PROXY=http://127.0.0.1:5179
# Prod-like static SPA:
# CHEMLAB_STATIC_DIR=apps/web/dist
CHEMLAB_COOKIE_SECURE=false
# false disables POST /api/auth/register (unset = enabled)
# CHEMLAB_SIGNUP_ENABLED=true
CHEMLAB_SESSION_TTL_HOURS=336
RUST_LOG=info,chemlab_server=debug
