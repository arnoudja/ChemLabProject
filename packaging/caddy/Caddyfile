# Reverse-proxy HTTPS to the ChemLab daemon on loopback.
# Packaged default: CHEMLAB_BIND=127.0.0.1:3847, CHEMLAB_COOKIE_SECURE=true.
#
# Run from the repo:
#   caddy run --config packaging/caddy/Caddyfile
#
# `:443` + `tls internal` serves HTTPS without a public hostname (Caddy local CA).
# For a public DNS name, replace `:443` with that name and drop `tls internal`
# so Caddy can obtain a Let's Encrypt certificate automatically.

:443 {
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	# HSTS is set on this Caddy HTTPS site only (not on Axum HTML / LAN HTTP).
	reverse_proxy 127.0.0.1:3847
	tls internal
}
